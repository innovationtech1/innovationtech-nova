# Copia de referencia SIN claves reales (esta sí se puede subir a GitHub).
# Las claves de verdad van en .env.local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase (Fase 3): datos de la cuenta de servicio (archivo .json de Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Panel de administrador (Fase 4)
# Clave web pública de Firebase (Configuración del proyecto → Tus apps → Web). No es secreta.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Correos con permiso de entrar a /admin, separados por coma
ADMIN_EMAILS=
